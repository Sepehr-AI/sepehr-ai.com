generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  email           String          @unique
  password        String
  name            String
  phoneNumber     String
  referralCode    String?
  referredBy      Referral[]      @relation("ReferredUser")
  referrals       Referral[]      @relation("UserReferrals")
  transactions    Transaction[]
  webLlmRequests  WebLlmRequest[]
  apiLlmRequests  ApiLlmRequest[]
  webBalance      Float           @default(0)
  apiBalance      Float           @default(0)
  referralBalance Float           @default(0)
  createdAt       DateTime        @default(now())
}

model Referral {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], name: "UserReferrals")
  userId    Int
  newUser   User     @relation(fields: [newUserId], references: [id], name: "ReferredUser")
  newUserId Int      @unique()
  createdAt DateTime @default(now())
}

model Transaction {
  id           Int      @id @default(autoincrement())
  amount       Int
  exchangeRate Int
  fee          Int?
  refId        Int?
  code         Int?
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
  createdAt    DateTime @default(now())
}

model ApiLlmRequest {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
  inputTokensUsed  Int
  outputTokensUsed Int
  cost             Float
  llmModel         LlmModel @relation(fields: [llmModelId], references: [id])
  llmModelId       Int
  createdAt        DateTime @default(now())
}

model WebLlmRequest {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
  inputTokensUsed  Int
  outputTokensUsed Int
  cost             Float
  llmModel         LlmModel @relation(fields: [llmModelId], references: [id])
  llmModelId       Int
  createdAt        DateTime @default(now())
}

enum EstimatedEncodingBase {
  O200K
  CL100K
  P50K
  R50K
}

model LlmModel {
  id                    Int                   @id @default(autoincrement())
  code                  String                @unique()
  name                  String                @unique()
  description           String
  costPerMilInToken     Float
  costPerMilOutToken    Float
  useToComparePlans     Boolean               @default(false)
  llmRequests           ApiLlmRequest[]
  WebLLMRequest         WebLlmRequest[]
  estimatedEncodingBase EstimatedEncodingBase
  createdAt             DateTime              @default(now())
}

model WebPlans {
  id           Int      @id @default(autoincrement())
  name         String
  credits      Int
  balance      Int
  price        Int
  displayPrice String
  updatedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
}
