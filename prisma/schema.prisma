generator client {
  previewFeatures = ["typedSql"]
  provider        = "prisma-client-js"
  output          = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  email           String?         @unique
  name            String
  mobile          String          @unique
  referralCode    String?
  otp             Otp[]
  referredBy      Referral[]      @relation("ReferredUser")
  referrals       Referral[]      @relation("UserReferrals")
  transactions    Transaction[]
  webLlmRequests  WebLlmRequest[]
  apiLlmRequests  ApiLlmRequest[]
  webBalance      Float           @default(0)
  apiBalance      Float           @default(0)
  referralBalance Float           @default(0)
  createdAt       DateTime        @default(now())
}

model Referral {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], name: "UserReferrals")
  userId    Int
  newUser   User     @relation(fields: [newUserId], references: [id], name: "ReferredUser")
  newUserId Int      @unique()
  createdAt DateTime @default(now())
}

model Transaction {
  id           Int      @id @default(autoincrement())
  amount       Int
  exchangeRate Int?
  fee          Int?
  refId        Int?
  code         Int?
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
  usdAmount    Int
  createdAt    DateTime @default(now())
}

model ApiLlmRequest {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
  inputTokensUsed  Int
  outputTokensUsed Int
  cost             Float
  llmModel         LlmModel @relation(fields: [llmModelId], references: [id])
  llmModelId       Int
  createdAt        DateTime @default(now())
}

model WebLlmRequest {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
  inputTokensUsed  Int
  outputTokensUsed Int
  cost             Float
  llmModel         LlmModel @relation(fields: [llmModelId], references: [id])
  llmModelId       Int
  createdAt        DateTime @default(now())
}

enum TiktokenEncoding {
  gpt2
  r50k_base
  p50k_base
  p50k_edit
  cl100k_base
  o200k_base
}

model LlmModel {
  id                    Int              @id @default(autoincrement())
  code                  String           @unique()
  name                  String
  description           String
  companyWebsite        String
  costPerMilInToken     Float
  costPerMilOutToken    Float
  useToComparePlans     Boolean          @default(false)
  inputModalities       String[]         @default(["text"])
  outputModalities      String[]         @default(["text"])
  llmRequests           ApiLlmRequest[]
  WebLLMRequests        WebLlmRequest[]
  estimatedEncodingBase TiktokenEncoding
  createdAt             DateTime         @default(now())
}

model WebPlan {
  id        Int      @id @default(autoincrement())
  name      String
  credits   Int
  usdAmount Int
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model Otp {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique
  code      String
  createdAt DateTime @default(now())
}
