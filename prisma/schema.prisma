generator client {
  previewFeatures = ["typedSql"]
  provider        = "prisma-client-js"
  output          = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  email            String?           @unique
  name             String
  mobile           String            @unique
  referralCode     String?
  otp              Otp?
  OpenrouterApiKey OpenrouterApiKey?
  referredBy       Referral[]        @relation("ReferredUser")
  referrals        Referral[]        @relation("UserReferrals")
  transactions     Transaction[]
  referralBalance  Float             @default(0)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
}

model Referral {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], name: "UserReferrals")
  userId    Int
  newUser   User     @relation(fields: [newUserId], references: [id], name: "ReferredUser")
  newUserId Int      @unique()
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Transaction {
  id                 Int     @id @default(autoincrement())
  amount             Int
  exchangeRate       Int?
  creditsTransferred Boolean @default(false)

  // Sepehrpay
  respCode       Int?
  traceNumber    Int?
  rrn            String?
  digitalReceipt String?
  cardNumber     String?
  status         String?
  message        String?
  returnId       String?

  user               User     @relation(fields: [userId], references: [id])
  userId             Int
  usdCredits         Int
  usdPrice           Float
  discountPercentage Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
}

model LlmModel {
  id                 Int      @id @default(autoincrement())
  code               String   @unique()
  name               String
  description        String
  companyWebsite     String
  priority           Int?
  costPerMilInToken  Float
  costPerMilOutToken Float
  useToComparePlans  Boolean  @default(false)
  inputModalities    String[] @default(["text"])
  outputModalities   String[] @default(["text"])
  contextLength      Int
  disabled           Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
}

model WebPlan {
  id                 Int       @id @default(autoincrement())
  name               String
  usdPrice           Float
  usdCredits         Int
  discountPercentage Int?
  discountEndsOn     DateTime? @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
}

model Otp {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique
  code      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model OpenrouterApiKey {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique
  limit     Int
  metadata  Bytes
  hash      String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Faq {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

enum ErrorType {
  INFO
  WARN
  ERROR
}

model Error {
  id        Int       @id @default(autoincrement())
  data      Json
  context   String
  type      ErrorType
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
}
