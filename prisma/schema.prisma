generator client {
  previewFeatures = ["typedSql"]
  provider        = "prisma-client-js"
  output          = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int           @id @default(autoincrement())
  email           String?       @unique
  name            String
  mobile          String        @unique
  referralCode    String?
  otp             Otp?
  genJobs         GenJob[]
  transactions    Transaction[]
  languageJobs    LanguageJob[]
  balance         Float         @default(0)
  referralBalance Float         @default(0)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
}

model Transaction {
  id                 Int     @id @default(autoincrement())
  amount             Int
  exchangeRate       Int?
  creditsTransferred Boolean @default(false)

  // Sepehrpay
  respCode       Int?
  traceNumber    Int?
  rrn            String?
  digitalReceipt String?
  cardNumber     String?
  status         String?
  message        String?
  returnId       String?

  // Relations
  user                User            @relation(fields: [userId], references: [id])
  userId              Int
  usdCredits          Int
  usdPrice            Float
  discountPercentage  Int?
  coupon              DiscountCoupon? @relation(fields: [couponId], references: [id])
  couponId            Int?
  couponDiscountToman Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model WebPlan {
  id                 Int       @id @default(autoincrement())
  name               String
  usdPrice           Float
  usdCredits         Int
  discountPercentage Int?
  discountEndsOn     DateTime? @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
}

model DiscountCoupon {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  usageCapacity Int
  // If number -> toomans minus 'amount'
  // If number% -> toomans minus 'amount' percent of the whole price
  amount        String
  endsOn        DateTime?     @db.Timestamptz(3)
  // Relation for usage tracking through transactions
  transactions  Transaction[]
  updatedAt     DateTime      @default(now()) @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
}

model Otp {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique
  code      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Faq {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

enum ErrorType {
  INFO
  WARN
  ERROR
}

model Error {
  id        Int       @id @default(autoincrement())
  data      Json
  context   String
  type      ErrorType
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
}

enum ImageInput {
  UNAVAILABLE
  SINGLE
  MULTI
}

model LanguageModel {
  id                     Int        @id @default(autoincrement())
  code                   String     @unique()
  name                   String
  description            String
  shortDescription       String
  milInCost              Float
  milOutCost             Float
  imageInput             ImageInput
  supportsMessages       Boolean
  defaultOptions         Json?
  // The least amount of output tokens possible
  minCompletionTokens    Int?
  // The most amount of output tokens possible
  maxCompletionTokens    Int?
  // The default maximum amount of generated output tokens
  defMaxCompletionTokens Int?
  disabled               Boolean    @default(false)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
}

model ImageModel {
  id               Int      @id @default(autoincrement())
  code             String   @unique()
  name             String
  description      String
  shortDescription String
  costPerImage     Float
  // Checkout lib/modelInput.ts
  inputSchema      Json
  defaultOptions   Json?
  hasShowCaseImage Boolean  @default(false)
  disabled         Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
}

model VideoModel {
  id               Int      @id @default(autoincrement())
  code             String   @unique()
  name             String
  description      String
  shortDescription String
  costPerSecond    Float
  // Checkout lib/modelInput.ts
  inputSchema      Json
  defaultOptions   Json?
  hasShowCaseVideo Boolean  @default(false)
  disabled         Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
}

enum JobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum GenKind {
  IMAGE
  VIDEO
}

model GenJob {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  GenKind
  model String

  // progress
  progress Int       @default(0)
  status   JobStatus @default(QUEUED)

  // replicate metadata
  replicateId        String?
  replicateGetUrl    String?
  replicateCancelUrl String?
  replicateWebUrl    String?

  // Uploaded files to the provider
  uploadedFileIds String[]

  // result
  resultUrl String?
  cost      Float

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model LanguageJob {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cost      Float?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}
